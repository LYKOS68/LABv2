{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labv2.local/hub/chatroom.schema.json",
  "title": "RAP-LAB Hub Chatroom Message",
  "description": "Ein Eintrag (eine Zeile) in hub/chatroom.jsonl. Append-only: bestehende Zeilen werden nie veraendert oder geloescht, nur neue angehaengt.",
  "type": "object",
  "required": ["id", "timestamp", "from", "to", "content"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Eindeutige ID, z.B. UUID oder fortlaufende Nummer als String."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "RFC3339/ISO8601, UTC."
    },
    "from": {
      "type": "string",
      "description": "Absender-Kennung, z.B. 'roman', 'claude-cli', 'agy'."
    },
    "to": {
      "type": "string",
      "description": "Empfaenger-Kennung oder 'all' fuer alle."
    },
    "type": {
      "type": "string",
      "enum": ["note", "task", "question", "status", "answer"],
      "description": "Nachrichtenart, optional."
    },
    "content": {
      "type": "string",
      "description": "Freitext-Inhalt der Nachricht."
    },
    "refId": {
      "type": "string",
      "description": "Optional: id einer vorherigen Nachricht, auf die sich diese bezieht (Antwort-Kette)."
    }
  }
}
